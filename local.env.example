# Box-specific settings, read by the Makefile here, bench/run_tqp.sh and
# baselines/docker/run.sh (`make -C baselines`); the environment wins over them.
# Copy to local.env, which is gitignored, and edit. One KEY=value per line.

# Datasets: $DATA_DIR/sf<SF>/parquet; format variants in $DATA_DIR/fmt_sf<SF>/.
# $DATA_DIR is the Makefile's default TQP_DATA_DIR, the data root TQP-Vortex
# reads. Needs ~0.4 TB per SF1000.
DATA_DIR=/path/to/tpch-data

# Engine scratch (Spark local dirs, Polars spill, probe scratch, tqp_vortex's run
# CSV) and the container's HOME. Keep it off a small root disk.
SCRATCH=/path/to/scratch

# Ramdisk root the datasets are staged to before a run (SF500 is ~180 GB).
SHM=/dev/shm

# The one GPU (host index) the GPU engines use, TQP-Vortex too (the Makefile's
# default TQP_GPU). GPUs are shared: pick an idle, non-exclusive one
# (`make -C baselines doctor` checks). The baselines' container is bound to this
# GPU's NUMA node (its CPUs and memory); NUMA=off unbinds it.
GPU=7
