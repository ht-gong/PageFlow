# Every toolchain pin the harness uses. docker/Dockerfile receives each line as a
# build argument, and the image tag is a hash of this file plus docker/*.lock, so
# a pin change always produces a new image. A version bump is its own change and
# means re-running the results it affects.

# Base OS: Ubuntu 24.04 (Python 3.12.3, gcc 13.3, glibc 2.39), by digest; apt
# packages come from this archive snapshot so they cannot drift either.
UBUNTU_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
UBUNTU_SNAPSHOT=20260930T000000Z

# JDK for Spark 3.5 (RAPIDS): Temurin 17.0.20.1+1.
JDK_URL=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.20.1%2B1/OpenJDK17U-jdk_x64_linux_hotspot_17.0.20.1_1.tar.gz
JDK_SHA256=3808d1d15e3ec6bd5b84057fb5d84c33d8a1536a258146bcea2e603fc726e08e

# Python envs: exact package sets with hashes in docker/py.lock (pyspark 3.5.8,
# py4j 0.10.9.9, pyarrow 25.0.1, duckdb 1.5.5) and docker/polars.lock
# (polars 1.39.3, cudf-polars-cu13 26.6.0).

# Rust for datagen/ndsgen, the TPC-H generator: rustup-init 1.29.1 and the
# toolchain it installs. ndsgen's crates (tpchgen 3.0.0, the dbgen 2.17.3 port;
# arrow/parquet 59) are pinned with checksums in datagen/ndsgen/Cargo.lock.
RUSTUP_URL=https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init
RUSTUP_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
RUST_VERSION=1.99.0

# RAPIDS Accelerator for Spark (runs on the pyspark 3.5.8 Spark).
RAPIDS_JAR_NAME=rapids-4-spark_2.12-26.04.2-cuda12.jar
RAPIDS_JAR_URL=https://repo1.maven.org/maven2/com/nvidia/rapids-4-spark_2.12/26.04.2/rapids-4-spark_2.12-26.04.2-cuda12.jar
RAPIDS_JAR_SHA1=23868adb7d9a718deb88caa587291628ca3fb48b

# Sirius at a fixed commit; its submodules follow from it (DuckDB = the
# sirius-db/duckdb v1.5.5-patches branch @ 3ff87f1ec7), and its toolchain
# (libcudf 26.08.01, CUDA 13.3, clang 21) from its own pixi.lock, installed
# --frozen. Built for H100 only.
SIRIUS_URL=https://github.com/sirius-db/sirius.git
SIRIUS_REF=d79d4f978be9b1eae7a30a83eed269071eb3fff3
SIRIUS_CUDAARCHS=90a-real;90
PIXI_URL=https://github.com/prefix-dev/pixi/releases/download/v0.81.0/pixi-x86_64-unknown-linux-musl.tar.gz
PIXI_SHA256=7aa3ec39aecceff9062fa2ed4d42cbaa0bdc25ddea727d048e061cf188d434f6
